    { "target": "dxbc",       "TIER": [0],    "reason": "shaderc emits SM 5.0 (vs_5_0/ps_5_0) = D3D11 FL11_x = T1; the T0 D3D11 FL10_x backend needs SM 4.0 profiles, not part of F1" },
