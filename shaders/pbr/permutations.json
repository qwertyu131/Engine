  "fixed": {
    "FG_CLEARCOAT_SHEEN_SPEC": 0,
    "FG_TRANSMISSION_VOLUME": 0
  },
  "targets": {
    "dxil":       { "tiers": [2], "backend": "D3D12" },
    "spirv":      { "tiers": [2], "backend": "Vulkan 1.2+" },
