    "dxbc":       { "tiers": [1], "backend": "D3D11 FL11_x (SM 5.0)" },
    "glsl-es320": { "tiers": [1], "backend": "OpenGL ES 3.2" },
    "wgsl":       { "tiers": [1], "backend": "WebGPU" },
